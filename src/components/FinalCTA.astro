---
import { getLocale, dict } from '../i18n';
import { waBookCallLink, waGenericDemoLink, waLink, VERTICALS } from '../data/demos';

const lang = getLocale(Astro.url);
const t = dict(lang);

// Primary: generic until the visitor selects a vertical in the hero.
const tryDemoLink = waGenericDemoLink(lang);
const demoLinks = Object.fromEntries(VERTICALS.map((v) => [v.id, waLink(v.id, lang)]));

// Secondary: book a call — also WhatsApp, different prefill.
const bookCallLink = waBookCallLink(lang);
---

<section id="demo" class="cta" aria-labelledby="cta-title">
  <div aria-hidden="true" class="cta__glow"></div>

  <p class="cta__eyebrow">{t.final_cta.eyebrow}</p>
  <h2 class="cta__title" id="cta-title">{t.final_cta.title}</h2>
  <p class="cta__sub">{t.final_cta.sub}</p>

  <div class="cta__actions">
    <a href={tryDemoLink} target="_blank" rel="noopener noreferrer" class="btn-primary cta__btn"
       data-demo-cta
       data-track="cta_click_finalcta" data-track-action="try_demo">
      {t.final_cta.primary} →
    </a>
    <a href={bookCallLink} target="_blank" rel="noopener noreferrer" class="btn-secondary cta__btn"
       data-track="cta_click_finalcta" data-track-action="book_call">
      {t.final_cta.secondary}
    </a>
  </div>
</section>

<script is:inline define:vars={{ demoLinks, tryDemoLink }}>
  (() => {
    const storageKey = 'clamai:selected-vertical';
    const updateDemoLinks = (vertical) => {
      const href = demoLinks[vertical] || tryDemoLink;
      document.querySelectorAll('[data-demo-cta]').forEach((link) => {
        link.setAttribute('href', href);
      });
    };

    try {
      updateDemoLinks(window.localStorage?.getItem(storageKey));
    } catch (_) {
      updateDemoLinks(null);
    }

    window.addEventListener('clamai:vertical-changed', (event) => {
      updateDemoLinks(event.detail?.vertical);
    });
  })();
</script>

<style>
  .cta {
    position: relative;
    text-align: center;
    padding: var(--sp-9) var(--sp-5);
    max-width: var(--container-narrow);
    margin: 0 auto;
    overflow: hidden;
  }
  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(212, 175, 55, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta__eyebrow {
    position: relative;
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-4);
  }
  .cta__title {
    position: relative;
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50, "WONK" 0;
    font-size: var(--fs-4xl);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.05;
    margin: 0 0 var(--sp-4);
  }
  .cta__sub {
    position: relative;
    font-size: var(--fs-md);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto var(--sp-7);
  }
  .cta__actions {
    position: relative;
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta__btn {
    min-width: 180px;
    justify-content: center;
  }
</style>
