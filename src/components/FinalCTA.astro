---
import { getLocale, dict } from '../i18n';
import { WA_NUMBER, VERTICALS } from '../data/demos';

const lang = getLocale(Astro.url);
const t = dict(lang);

// Default prefill for the final CTA = restaurant (most common). Hero allows switching.
const v = VERTICALS[0];
const prefill = encodeURIComponent(lang === 'es' ? v.prefill_es : v.prefill_en);
const waLink = `https://wa.me/${WA_NUMBER}?text=${prefill}`;

// TODO: replace with real Calendly URL once user provides it.
const calendlyLink = 'https://calendly.com/theclamai/intro';
---

<section id="demo" class="cta" aria-labelledby="cta-title">
  <div aria-hidden="true" class="cta__glow"></div>

  <p class="cta__eyebrow">{t.final_cta.eyebrow}</p>
  <h2 class="cta__title" id="cta-title">{t.final_cta.title}</h2>
  <p class="cta__sub">{t.final_cta.sub}</p>

  <div class="cta__actions">
    <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-primary cta__btn">
      {t.final_cta.primary} →
    </a>
    <a href={calendlyLink} target="_blank" rel="noopener noreferrer" class="btn-secondary cta__btn">
      {t.final_cta.secondary}
    </a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    text-align: center;
    padding: var(--sp-9) var(--sp-5);
    max-width: var(--container-narrow);
    margin: 0 auto;
    overflow: hidden;
  }
  .cta__glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(212, 175, 55, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }
  .cta__eyebrow {
    position: relative;
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-4);
  }
  .cta__title {
    position: relative;
    font-size: var(--fs-4xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 var(--sp-4);
  }
  .cta__sub {
    position: relative;
    font-size: var(--fs-md);
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 480px;
    margin: 0 auto var(--sp-7);
  }
  .cta__actions {
    position: relative;
    display: flex;
    gap: var(--sp-3);
    justify-content: center;
    flex-wrap: wrap;
  }
  .cta__btn {
    min-width: 180px;
    justify-content: center;
  }
</style>
