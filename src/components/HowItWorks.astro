---
import { getLocale, dict } from '../i18n';

const lang = getLocale(Astro.url);
const t = dict(lang);
const steps = t.how_it_works.steps;
---

<section id="how" class="how" aria-labelledby="how-title">
  <header class="how__head">
    <p class="how__eyebrow">{t.how_it_works.eyebrow}</p>
    <h2 class="how__title" id="how-title">{t.how_it_works.title}</h2>
  </header>

  <ol class="how__grid">
    {steps.map((s) => (
      <li class="how__card">
        <span class="how__num">{s.n}</span>
        <h3 class="how__step-title">{s.title}</h3>
        <p class="how__body">{s.body}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .how {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-9) var(--sp-5);
  }
  .how__head {
    text-align: center;
    margin-bottom: var(--sp-8);
  }
  .how__eyebrow {
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-3);
  }
  .how__title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50, "WONK" 0;
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .how__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--sp-4);
    counter-reset: step;
  }
  .how__card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s, transform 0.15s;
  }
  .how__card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .how__num {
    font-family: var(--font-mono-display);
    font-size: var(--fs-md);
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.08em;
    margin-bottom: var(--sp-5);
  }
  .how__step-title {
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--text);
    margin: 0 0 var(--sp-3);
    letter-spacing: -0.02em;
  }
  .how__body {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
</style>
