---
import { getLocale, dict } from '../i18n';

const lang = getLocale(Astro.url);
const t = dict(lang);
const items = t.capabilities.items;
const alsoIncluded = t.capabilities.also_included_items ?? [];
const alsoLabel = t.capabilities.also_included_label ?? '';

const ICONS: Record<number, string> = {
  0: 'M13 2L3 14h7l-1 8 10-12h-7l1-8z',
  1: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',
  2: 'M3 3v18h18M7 14l4-4 4 4 6-6',
};
---

<section class="caps" id="capabilities" aria-labelledby="caps-title">
  <header class="caps__head">
    <p class="caps__eyebrow">{t.capabilities.eyebrow}</p>
    <h2 class="caps__title" id="caps-title">{t.capabilities.title}</h2>
  </header>

  <ul class="caps__grid">
    {items.map((it, i) => (
      <li class="caps__cell">
        <span class="caps__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d={ICONS[i] ?? ICONS[0]} />
          </svg>
        </span>
        <h3 class="caps__cell-title">{it.title}</h3>
        <p class="caps__cell-body">{it.body}</p>
      </li>
    ))}
  </ul>

  {alsoIncluded.length > 0 && (
    <div class="caps__also">
      <span class="caps__also-label">{alsoLabel}</span>
      <ul class="caps__also-list">
        {alsoIncluded.map((item) => (
          <li class="caps__also-item">{item}</li>
        ))}
      </ul>
    </div>
  )}
</section>

<style>
  .caps {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-9) var(--sp-5);
  }
  .caps__head {
    text-align: center;
    margin-bottom: var(--sp-8);
  }
  .caps__eyebrow {
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-3);
  }
  .caps__title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50, "WONK" 0;
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: var(--text);
    margin: 0;
    letter-spacing: -0.02em;
    max-width: 720px;
    margin-inline: auto;
    line-height: 1.15;
  }
  .caps__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .caps__cell {
    background: var(--surface);
    padding: var(--sp-6);
    transition: background 0.15s;
  }
  .caps__cell:hover {
    background: var(--surface-2);
  }
  .caps__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: rgba(212, 175, 55, 0.08);
    color: var(--accent);
    margin-bottom: var(--sp-4);
  }
  .caps__cell-title {
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text);
    margin: 0 0 var(--sp-2);
    letter-spacing: -0.01em;
  }
  .caps__cell-body {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Also included strip */
  .caps__also {
    margin-top: var(--sp-7);
    padding-top: var(--sp-6);
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3) var(--sp-4);
  }
  .caps__also-label {
    font-family: var(--font-mono-display);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-dim);
  }
  .caps__also-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-3);
    justify-content: center;
  }
  .caps__also-item {
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-pill, 999px);
    background: var(--surface);
  }
</style>
