---
import { getLocale, dict } from '../i18n';
import { GENERIC_DEMO_PREFILL, VERTICALS, WA_NUMBER } from '../data/demos';
import VerticalSwitcher from './VerticalSwitcher.astro';
import LiveDemo from './LiveDemo.astro';

const lang = getLocale(Astro.url);
const t = dict(lang);
const labels = t.switcher.verticals;

const demoData = VERTICALS.map((v) => ({
  id: v.id,
  label: labels[v.id],
  prefill: encodeURIComponent(lang === 'es' ? v.prefill_es : v.prefill_en),
}));
const genericPrefill = encodeURIComponent(GENERIC_DEMO_PREFILL[lang]);

const heroAlpine = `{
  active: null,
  waNumber: ${JSON.stringify(WA_NUMBER)},
  demos: ${JSON.stringify(demoData)},
  genericPrefill: ${JSON.stringify(genericPrefill)},
  storageKey: 'clamai:selected-vertical',
  init() {
    try {
      const stored = window.localStorage?.getItem(this.storageKey);
      if (this.demos.some(x => x.id === stored)) this.active = stored;
    } catch (_) {}
  },
  currentDemo() {
    return this.demos.find(x => x.id === this.active) || null;
  },
  setActive(id) {
    this.active = id;
    try { window.localStorage?.setItem(this.storageKey, id); } catch (_) {}
    window.dispatchEvent(new CustomEvent('clamai:vertical-changed', { detail: { vertical: id } }));
  },
  waLink() {
    const d = this.currentDemo();
    return 'https://wa.me/' + this.waNumber + '?text=' + (d ? d.prefill : this.genericPrefill);
  },
  prefillText() {
    const d = this.currentDemo();
    return decodeURIComponent(d ? d.prefill : this.genericPrefill);
  }
}`;
---

<section class="hero" x-data={heroAlpine}>

  <!-- Radial accent glow -->
  <div aria-hidden="true" class="hero__glow"></div>

  <!-- Eyebrow badge -->
  <div class="hero__badge fade-up">
    <span class="pulse-dot"></span>
    <span>{t.hero.eyebrow}</span>
  </div>

  <!-- H1 -->
  <h1 class="hero__title fade-up fade-up-delay-1">
    {t.hero.title_pre}<br>
    <span class="hero__title-strong">{t.hero.title_strong}</span>
  </h1>

  <!-- Subhead -->
  <p class="hero__sub fade-up fade-up-delay-2">{t.hero.sub}</p>

  <!-- Vertical switcher -->
  <div class="fade-up fade-up-delay-3">
    <VerticalSwitcher />
  </div>

  <!-- Live demo card -->
  <div class="fade-up fade-up-delay-4">
    <LiveDemo />
  </div>

  <!-- Secondary CTA -->
  <a href="#how" class="hero__secondary-cta fade-up fade-up-delay-4">
    ↓ {t.nav.how_it_works}
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 140px 24px 80px;
    overflow: hidden;
  }
  .hero__glow {
    position: absolute;
    top: -120px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(212, 175, 55, 0.13) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(212, 167, 44, 0.28);
    border-radius: var(--r-pill);
    padding: 6px 14px;
    margin-bottom: 28px;
    background: rgba(212, 167, 44, 0.06);
    position: relative;
    z-index: 1;
    font-family: var(--font-mono-display);
    font-size: 11px;
    color: var(--accent);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .hero__title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50, "WONK" 0;
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--text);
    max-width: 880px;
    margin: 0 0 24px;
    position: relative;
    z-index: 1;
  }
  .hero__title-strong {
    color: var(--accent);
    font-weight: 600;
  }
  .hero__sub {
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 560px;
    margin: 0 0 8px;
    position: relative;
    z-index: 1;
  }
  .hero__secondary-cta {
    margin-top: 28px;
    font-size: 13px;
    color: var(--text-dim);
    transition: color 0.15s;
    position: relative;
    z-index: 1;
  }
  .hero__secondary-cta:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .hero { padding: 120px 16px 60px; }
  }
</style>
