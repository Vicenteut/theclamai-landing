---
import ProductPreview from './ProductPreview.astro';

const WA_LINK = "https://wa.me/501XXXXXXXX?text=demo";
---

<section style="position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;padding:160px 24px 80px;overflow:hidden;">

  <!-- Radial gold glow -->
  <div aria-hidden="true" style="position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:700px;height:500px;background:radial-gradient(ellipse 60% 50% at 50% 0%,rgba(212,175,55,0.13) 0%,transparent 70%);pointer-events:none;z-index:0;"></div>

  <!-- Badge -->
  <div class="fade-up" style="display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(212,175,55,0.25);border-radius:9999px;padding:6px 14px;margin-bottom:32px;background:rgba(212,175,55,0.05);position:relative;z-index:1;">
    <span class="pulse-dot"></span>
    <span style="font-size:12px;color:#D4AF37;font-weight:500;letter-spacing:0.04em;">Conversational AI for hospitality</span>
  </div>

  <!-- H1 -->
  <h1 class="fade-up" style="font-size:clamp(40px,7vw,80px);font-weight:700;letter-spacing:-0.04em;line-height:1.05;color:#ededed;max-width:760px;margin:0 0 24px;position:relative;z-index:1;animation-delay:0.05s;">
    Your guests message.<br>
    <span style="color:#D4AF37;">We answer.</span>
  </h1>

  <!-- Subhead -->
  <p class="fade-up" style="font-size:clamp(16px,2.2vw,20px);color:#888;line-height:1.6;max-width:520px;margin:0 0 40px;position:relative;z-index:1;animation-delay:0.1s;">
    An AI assistant that takes orders, books rooms, and answers guest questions on WhatsApp — in any language, around the clock.
  </p>

  <!-- CTAs -->
  <div class="fade-up" style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;position:relative;z-index:1;animation-delay:0.15s;">
    <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="btn-primary">
      Try the demo →
    </a>
    <a href="#how" class="btn-secondary">
      See how it works
    </a>
  </div>

  <!-- Sub note -->
  <p class="fade-up" style="font-size:12px;color:#333;margin-top:16px;position:relative;z-index:1;animation-delay:0.2s;">
    No card required · Cancel anytime · Live in 3 days
  </p>

  <!-- Product Preview -->
  <div class="fade-up" style="position:relative;z-index:1;width:100%;display:flex;justify-content:center;animation-delay:0.25s;">
    <ProductPreview />
  </div>

</section>
