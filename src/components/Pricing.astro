---
import { getLocale, dict } from '../i18n';
import { plans } from '../data/pricing';

const lang = getLocale(Astro.url);
const t = dict(lang);
const p = t.pricing;
---

<section id="pricing" class="pricing" aria-labelledby="pricing-title">
  <header class="pricing__head">
    <p class="pricing__eyebrow">{p.eyebrow}</p>
    <h2 class="pricing__title" id="pricing-title">{p.title}</h2>
    <p class="pricing__sub">{p.sub}</p>
  </header>

  <div class="pricing__grid">
    {plans.map((plan) => {
      const copy = p.plans[plan.id];
      return (
        <article class={`plan ${plan.featured ? 'plan--featured' : ''}`}>
          {plan.highlight === 'most_popular' && (
            <span class="plan__badge">{p.most_popular}</span>
          )}
          <p class="plan__name">{copy.name}</p>
          <div class="plan__price">
            {plan.priceUSD === null ? (
              <span class="plan__price-custom">{p.custom_price}</span>
            ) : (
              <>
                <span class="plan__price-currency">$</span>
                <span class="plan__price-amount">{plan.priceUSD}</span>
                <span class="plan__price-period">{p.period}</span>
              </>
            )}
          </div>
          <p class="plan__tagline">{copy.tagline}</p>

          <a
            href={plan.ctaHref}
            target="_blank"
            rel="noopener noreferrer"
            class={plan.featured ? 'btn-primary plan__cta' : 'btn-secondary plan__cta'}
            data-track="cta_click_pricing"
            data-track-plan={plan.id}
          >
            {copy.cta}
          </a>

          <ul class="plan__features">
            {copy.features.map((f) => (
              <li class="plan__feature">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8l3.5 3.5L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </article>
      );
    })}
  </div>
</section>

<style>
  .pricing {
    max-width: var(--container);
    margin: 0 auto;
    padding: var(--sp-9) var(--sp-5);
  }
  .pricing__head {
    text-align: center;
    margin-bottom: var(--sp-8);
  }
  .pricing__eyebrow {
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-3);
  }
  .pricing__title {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 50, "WONK" 0;
    font-size: var(--fs-3xl);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 var(--sp-3);
  }
  .pricing__sub {
    font-size: var(--fs-md);
    color: var(--text-muted);
    margin: 0;
    max-width: 540px;
    margin-inline: auto;
  }
  .pricing__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--sp-4);
    align-items: stretch;
  }
  .plan {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    padding: var(--sp-7);
    display: flex;
    flex-direction: column;
    transition: border-color 0.15s, transform 0.15s;
  }
  .plan:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }
  .plan--featured {
    border-color: rgba(212, 175, 55, 0.4);
    background: linear-gradient(180deg, rgba(212, 175, 55, 0.04) 0%, var(--surface) 60%);
  }
  .plan__badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent);
    color: #000;
    font-family: var(--font-mono-display);
    font-size: 10px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--r-pill);
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .plan__name {
    font-family: var(--font-mono-display);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-transform: uppercase;
    margin: 0 0 var(--sp-4);
  }
  .plan__price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    margin-bottom: var(--sp-3);
    min-height: 52px;
  }
  .plan__price-currency {
    font-size: 22px;
    color: var(--text-muted);
    font-weight: 500;
  }
  .plan__price-amount {
    font-size: 48px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text);
    line-height: 1;
  }
  .plan__price-period {
    font-size: var(--fs-sm);
    color: var(--text-dim);
    margin-left: 4px;
  }
  .plan__price-custom {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .plan__tagline {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0 0 var(--sp-6);
  }
  .plan__cta {
    display: block;
    text-align: center;
    margin-bottom: var(--sp-6);
  }
  .plan__features {
    list-style: none;
    padding: var(--sp-5) 0 0;
    margin: 0;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .plan__feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.45;
  }
  .plan__feature svg {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--accent);
  }
</style>
