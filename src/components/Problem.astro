---
const problems = [
  {
    stat: "68%",
    label: "of guests message before calling",
    body: "Your front desk can't reply instantly at 2 AM. Your AI can — every time, in every language.",
  },
  {
    stat: "4 min",
    label: "average response delay per message",
    body: "Every minute of silence is a booking reconsidering. Instant replies convert at 3× the rate.",
  },
  {
    stat: "1 in 3",
    label: "orders lost to missed messages",
    body: "Busy service, ringing phone, 10 WhatsApp threads. The Clam AI handles all of them simultaneously.",
  },
];
---

<section id="problem" style="padding:80px 24px;max-width:1000px;margin:0 auto;">

  <p class="section-label" style="text-align:center;margin-bottom:12px;">The problem</p>
  <h2 style="font-size:clamp(26px,4vw,40px);font-weight:700;letter-spacing:-0.03em;color:#ededed;text-align:center;margin:0 0 64px;max-width:560px;margin-left:auto;margin-right:auto;">
    Your team isn't slow. WhatsApp just wasn't built for this.
  </h2>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:1px;border:1px solid rgba(255,255,255,0.08);border-radius:16px;overflow:hidden;background:rgba(255,255,255,0.08);">
    {problems.map((p) => (
      <div class="problem-cell" style="background:#000;padding:32px 28px;">
        <p style="font-size:40px;font-weight:700;letter-spacing:-0.04em;color:#D4AF37;margin:0 0 4px;font-variant-numeric:tabular-nums;">{p.stat}</p>
        <p style="font-size:12px;color:#555;text-transform:uppercase;letter-spacing:0.08em;margin:0 0 16px;">{p.label}</p>
        <p style="font-size:14px;color:#888;line-height:1.65;margin:0;">{p.body}</p>
      </div>
    ))}
  </div>

</section>
