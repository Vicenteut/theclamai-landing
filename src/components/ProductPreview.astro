        <div style="max-width:85%;margin-left:auto;">
          <div style="background:rgba(212,175,55,0.12);border:1px solid rgba(212,175,55,0.18);border-radius:12px 4px 12px 12px;padding:8px 12px;font-size:12px;color:#E8C547;line-height:1.5;">
