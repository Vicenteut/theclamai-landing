            <span style="font-size:10px;background:rgba(212,175,55,0.15);color:#D4AF37;padding:2px 8px;border-radius:9999px;font-weight:500;white-space:nowrap;">New</span>
            <span style="font-size:12px;color:#888;flex:1;">Table 4 · Chicken + rice</span>
            <span style="font-size:11px;color:#333;font-family:monospace;">0:43</span>
          </div>
          <div style="background:rgba(212,175,55,0.04);border:1px solid rgba(212,175,55,0.25);border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:10px;">
            <span style="font-size:10px;background:rgba(212,175,55,0.15);color:#D4AF37;padding:2px 8px;border-radius:9999px;font-weight:500;white-space:nowrap;">New</span>
            <span style="font-size:12px;color:#888;flex:1;">Delivery · 3 items</span>
            <span style="font-size:11px;color:#333;font-family:monospace;">1:12</span>
