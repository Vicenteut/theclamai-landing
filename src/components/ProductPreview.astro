        <div style="max-width:85%;">
          <div style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:4px 12px 12px 12px;padding:8px 12px;font-size:12px;color:#888;line-height:1.5;">
            Ocean-view, for 2 adults.
          </div>
          <p style="font-size:10px;color:#555;margin-top:3px;padding:0 2px;">8:15 PM</p>
        </div>

        <div style="max-width:85%;margin-left:auto;">
          <div style="background:rgba(212,175,55,0.12);border:1px solid rgba(212,175,55,0.18);border-radius:12px 4px 12px 12px;padding:8px 12px;font-size:12px;color:#E8C547;line-height:1.5;">
            Booked ✓ Ocean-view, June 12–15, 2 adults · $780 total.
          </div>
          <p style="font-size:10px;color:#555;margin-top:3px;padding:0 2px;text-align:right;">8:15 PM · ✓✓</p>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  @media (max-width: 640px) {
    .preview-grid {
      grid-template-columns: 1fr !important;
