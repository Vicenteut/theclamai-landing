        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        app.theclamai.com/dashboard
      </div>
    </div>

    <!-- Content grid -->
    <div class="preview-grid" style="display:grid;grid-template-columns:1fr 1fr;min-height:280px;">

      <!-- LEFT: Kanban orders -->
      <div style="padding:28px;border-right:1px solid rgba(255,255,255,0.08);">
