<div style="position:relative;z-index:1;margin-top:72px;width:100%;max-width:880px;">
  <!-- Browser frame -->
  <div style="border:1px solid rgba(255,255,255,0.08);border-radius:16px;overflow:hidden;background:#111;box-shadow:0 0 0 1px rgba(255,255,255,0.03),0 40px 80px rgba(0,0,0,0.8),0 0 80px rgba(212,175,55,0.04);">

    <!-- Browser bar -->
    <div style="padding:12px 16px;border-bottom:1px solid rgba(255,255,255,0.08);display:flex;align-items:center;gap:8px;background:rgba(0,0,0,0.4);">
      <div style="width:10px;height:10px;border-radius:50%;background:#ff5f57;flex-shrink:0;"></div>
      <div style="width:10px;height:10px;border-radius:50%;background:#febc2e;flex-shrink:0;"></div>
      <div style="width:10px;height:10px;border-radius:50%;background:#28c840;flex-shrink:0;"></div>
