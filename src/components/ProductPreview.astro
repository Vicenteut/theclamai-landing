          <div style="background:rgba(255,255,255,0.03);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:10px 12px;display:flex;align-items:center;gap:10px;">
            <span style="font-size:10px;background:rgba(251,191,36,0.12);color:#fbbf24;padding:2px 8px;border-radius:9999px;font-weight:500;white-space:nowrap;">Prep</span>
            <span style="font-size:12px;color:#888;flex:1;">Pickup · Burger meal</span>
            <span style="font-size:11px;color:#333;font-family:monospace;">8:30</span>
