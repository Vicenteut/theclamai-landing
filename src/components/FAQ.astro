---
import { getLocale, dict } from '../i18n';

const lang = getLocale(Astro.url);
const t = dict(lang);
const items = t.faq.items;
---

<section id="faq" class="faq" aria-labelledby="faq-title">
  <header class="faq__head">
    <p class="faq__eyebrow">{t.faq.eyebrow}</p>
    <h2 class="faq__title" id="faq-title">{t.faq.title}</h2>
  </header>

  <div class="faq__list">
    {items.map((item) => (
      <div class="faq__item" x-data="{ open: false }">
        <button
          type="button"
          x-on:click="open = !open"
          class="faq__q"
          aria-expanded="false"
          x-bind:aria-expanded="open.toString()"
        >
          <span>{item.q}</span>
          <span class="faq__plus" x-text="open ? '−' : '+'" aria-hidden="true">+</span>
        </button>
        <div x-show="open" x-collapse>
          <p class="faq__a">{item.a}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: var(--sp-9) var(--sp-5);
  }
  .faq__head {
    text-align: center;
    margin-bottom: var(--sp-8);
  }
  .faq__eyebrow {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    font-weight: 500;
    margin: 0 0 var(--sp-3);
  }
  .faq__title {
    font-size: var(--fs-3xl);
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0;
  }
  .faq__list {
    display: flex;
    flex-direction: column;
  }
  .faq__item {
    border-bottom: 1px solid var(--border);
  }
  .faq__q {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    text-align: left;
    background: transparent;
    border: none;
    cursor: pointer;
    font: inherit;
    color: var(--text);
    font-size: var(--fs-md);
    font-weight: 500;
    line-height: 1.45;
  }
  .faq__q:hover .faq__plus {
    color: var(--accent);
  }
  .faq__plus {
    flex-shrink: 0;
    font-size: 22px;
    color: var(--text-dim);
    width: 24px;
    text-align: center;
    font-weight: 300;
    transition: color 0.15s;
  }
  .faq__a {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.7;
    padding: 0 0 18px;
    margin: 0;
    max-width: 92%;
  }
</style>
