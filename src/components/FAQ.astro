---
const faqs = [
  {
    q: "What exactly does The Clam AI do?",
    a: "It acts as an AI-powered assistant connected to your WhatsApp Business number. It reads incoming messages from guests, understands them in any language, and responds with accurate, on-brand replies — handling orders, bookings, FAQs, and more.",
  },
  {
    q: "Do I need technical knowledge to set it up?",
    a: "None at all. You have a 30-minute briefing call with our team, share your menu or room details, and we handle everything — configuration, testing, and go-live.",
  },
  {
    q: "What languages does it support?",
    a: "The Clam AI detects the language of each guest automatically and responds in kind. It currently supports 20+ languages including English, Spanish, French, German, Portuguese, Chinese, and Arabic.",
  },
  {
    q: "What happens when the AI can't answer?",
    a: "Any message the AI is not confident about is immediately flagged and handed off to your team. You set the escalation rules — by topic, time of day, or confidence threshold.",
  },
  {
    q: "Can it take orders or make bookings?",
    a: "Yes. For restaurants, it captures order details and sends them to your kitchen system or POS. For hotels, it checks availability and confirms reservations, with optional PMS integration on Pro.",
  },
  {
    q: "Is my guests' data secure?",
    a: "All data is encrypted in transit and at rest. We are fully GDPR-compliant and do not sell or share guest data. Conversation retention is configurable per client.",
  },
  {
    q: "How long does it take to go live?",
    a: "Most clients go live within 72 hours of their onboarding call. Complex integrations (PMS/POS) may take up to a week.",
  },
  {
    q: "Can I cancel at any time?",
    a: "Yes. Both plans are month-to-month with no long-term commitment. Your WhatsApp number stays yours and all data is exported within 48 hours.",
  },
];
---

<section id="faq" style="padding:80px 24px;max-width:720px;margin:0 auto;">

  <p class="section-label" style="text-align:center;margin-bottom:12px;">FAQ</p>
  <h2 style="font-size:clamp(26px,4vw,40px);font-weight:700;letter-spacing:-0.03em;color:#ededed;text-align:center;margin:0 0 56px;">
    Common questions
  </h2>

  <div style="display:flex;flex-direction:column;">
    {faqs.map((faq) => (
      <div x-data="{ open: false }" style="border-bottom:1px solid rgba(255,255,255,0.08);">
        <button
          x-on:click="open = !open"
          style="width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:18px 0;text-align:left;background:transparent;border:none;cursor:pointer;"
          aria-expanded="false"
          x-bind:aria-expanded="open.toString()"
        >
          <span style="font-size:15px;font-weight:500;color:#ededed;line-height:1.45;">{faq.q}</span>
          <span
            x-text="open ? '−' : '+'"
            style="flex-shrink:0;font-size:18px;color:#555;width:20px;text-align:center;transition:color .15s;font-weight:300;"
          >+</span>
        </button>
        <div x-show="open" x-collapse>
          <p style="font-size:14px;color:#888;line-height:1.7;padding:0 0 18px;margin:0;">{faq.a}</p>
        </div>
      </div>
    ))}
  </div>

</section>
