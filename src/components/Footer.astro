---
const year = new Date().getFullYear();
---

<footer style="border-top:1px solid rgba(255,255,255,0.06);padding:40px 24px;max-width:1000px;margin:0 auto;">

  <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:32px;flex-wrap:wrap;">

    <!-- Logo + tagline -->
    <div style="flex:1;min-width:200px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:8px;text-decoration:none;margin-bottom:8px;">
        <svg width="18" height="18" viewBox="0 0 100 100" fill="none" aria-hidden="true">
          <path d="M 75 22 Q 28 12 22 50 Q 28 88 75 78" stroke="#D4AF37" stroke-width="7" stroke-linecap="round" fill="none"/>
          <circle cx="19" cy="50" r="4" fill="#D4AF37"/>
        </svg>
        <span style="font-size:14px;font-weight:600;color:#ededed;letter-spacing:-0.02em;">The Clam AI</span>
      </a>
      <p style="font-size:13px;color:#333;line-height:1.55;max-width:220px;margin:0;">
        Conversational AI for hotels, restaurants & vacation rentals.
      </p>
    </div>

    <!-- Navigation links -->
    <nav aria-label="Footer navigation" style="display:flex;gap:48px;flex-wrap:wrap;">
      <div>
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:#444;margin:0 0 12px;font-weight:600;">Product</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
          <li><a href="#how" style="font-size:13px;color:#555;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#ededed'" onmouseout="this.style.color='#555'">How it works</a></li>
          <li><a href="#pricing" style="font-size:13px;color:#555;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#ededed'" onmouseout="this.style.color='#555'">Pricing</a></li>
          <li><a href="#faq" style="font-size:13px;color:#555;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#ededed'" onmouseout="this.style.color='#555'">FAQ</a></li>
        </ul>
      </div>
      <div>
        <p style="font-size:11px;text-transform:uppercase;letter-spacing:0.1em;color:#444;margin:0 0 12px;font-weight:600;">Legal</p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
          <li><a href="/legal/privacy" style="font-size:13px;color:#555;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#ededed'" onmouseout="this.style.color='#555'">Privacy</a></li>
          <li><a href="/legal/terms" style="font-size:13px;color:#555;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#ededed'" onmouseout="this.style.color='#555'">Terms</a></li>
        </ul>
      </div>
    </nav>

  </div>

  <!-- Bottom bar -->
  <div style="margin-top:36px;padding-top:20px;border-top:1px solid rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
    <p style="font-size:12px;color:#333;margin:0;">© {year} The Clam AI. All rights reserved.</p>
    <a href="mailto:hello@theclamai.com" style="font-size:12px;color:#444;text-decoration:none;transition:color .15s;" onmouseover="this.style.color='#D4AF37'" onmouseout="this.style.color='#444'">hello@theclamai.com</a>
  </div>

</footer>
