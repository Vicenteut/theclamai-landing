---
import { getLocale, dict } from '../i18n';
import LangToggle from './LangToggle.astro';
import Logo from './Logo.astro';

const lang = getLocale(Astro.url);
const t = dict(lang);
const year = new Date().getFullYear();
const privacyHref = lang === 'es' ? '/es/legal/privacy' : '/legal/privacy';
const termsHref = lang === 'es' ? '/es/legal/terms' : '/legal/terms';
---

<footer class="footer">
  <div class="footer__inner">
    <div class="footer__brand">
      <a href={lang === 'es' ? '/es' : '/'} class="footer__logo">
        <Logo size={20} />
      </a>
      <p class="footer__tagline">{t.footer.tagline}</p>
    </div>

    <nav aria-label={t.footer.nav_label} class="footer__nav">
      <div>
        <p class="footer__h">{t.footer.product}</p>
        <ul class="footer__list">
          <li><a href="#how" class="footer__link">{t.nav.how_it_works}</a></li>
          <li><a href="#verticals" class="footer__link">{t.nav.verticals}</a></li>
          <li><a href="#pricing" class="footer__link">{t.nav.pricing}</a></li>
          <li><a href="#faq" class="footer__link">{t.nav.faq}</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__h">{t.footer.links_legal}</p>
        <ul class="footer__list">
          <li><a href={privacyHref} class="footer__link">{t.footer.links_privacy}</a></li>
          <li><a href={termsHref} class="footer__link">{t.footer.links_terms}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer__bottom">
    <p class="footer__copy">© {year} The Clam AI. {t.footer.rights}</p>
    <div class="footer__bottom-right">
      <LangToggle />
      <a href="mailto:hello@theclamai.com" class="footer__email">hello@theclamai.com</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--sp-7) var(--sp-5);
    max-width: var(--container);
    margin: 0 auto;
  }
  .footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }
  .footer__brand {
    flex: 1;
    min-width: 220px;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-2);
  }
  .footer__tagline {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    line-height: 1.55;
    max-width: 240px;
    margin: 0;
  }
  .footer__nav {
    display: flex;
    gap: var(--sp-7);
    flex-wrap: wrap;
  }
  .footer__h {
    font-family: var(--font-mono-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin: 0 0 var(--sp-3);
    font-weight: 500;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .footer__link {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__link:hover {
    color: var(--text);
  }
  .footer__bottom {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .footer__copy {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    margin: 0;
  }
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .footer__email {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__email:hover {
    color: var(--accent);
  }
</style>
