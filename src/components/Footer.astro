---
import { getLocale, dict } from '../i18n';
import LangToggle from './LangToggle.astro';

const lang = getLocale(Astro.url);
const t = dict(lang);
const year = new Date().getFullYear();
const privacyHref = lang === 'es' ? '/es/legal/privacy' : '/legal/privacy';
const termsHref = lang === 'es' ? '/es/legal/terms' : '/legal/terms';
---

