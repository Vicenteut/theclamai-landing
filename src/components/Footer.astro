  <div class="footer__inner">
    <div class="footer__brand">
      <a href={lang === 'es' ? '/es' : '/'} class="footer__logo">
        <svg width="20" height="20" viewBox="0 0 2048 2048" fill="none" aria-hidden="true">
          <path fill="var(--accent)" d="M995 631.6c-28.9 2.7-51.7 6.8-79.1 14.4-47 13-88.3 33.8-131.4 66-29.4 22-52.3 45.2-77.8 78.8-16.4 21.6-35.5 54.8-46.5 80.9-46.2 109-40.5 232.8 15.5 337.8 19.8 37 49.1 75.4 78.3 102.4 60.3 55.8 134 90.4 217.7 102.3 14 2 19.9 2.2 51.3 2.3 31.2 0 37.5-.3 51.8-2.3 82.7-11.3 153.5-43.8 215.1-98.7 15.9-14.3 23.2-21.8 36.3-37.5 52.8-63.6 83-134.6 91.3-214.2 1.7-17.1 2-57.6.5-74.8-5.2-57.4-24.7-116.9-54.5-166-18.8-30.9-35.1-51.5-62.7-78.6-47.4-46.6-97.9-76.6-163.7-97-21.8-6.8-39.9-10.6-66-14-11.2-1.4-65.9-2.7-76.1-1.8m68 31.9c51.6 5.8 102.7 22.9 145.5 48.8 24.8 15 41.6 27.4 61.6 45.3 27.5 24.8 52.1 55.8 73 92 17.7 30.8 35.7 81.4 40.3 113.9 7.5 51.8 5.8 101.8-4.9 145.4-13.6 55.5-39.8 106.8-75.7 148.6-10.5 12.2-35.9 37.6-45.3 45.3-10.2 8.3-30.6 22.5-45.6 31.7-42.1 25.9-94.1 43.8-145 50.2-16.8 2-59.9 2.3-77.9.5-75.9-7.9-146-37.8-202.6-86.3-36-30.9-67.1-71.3-89.6-116.1-19.4-38.8-33.1-89.2-35.5-130.9l-.6-10.6 17.6-.6c21.8-.8 49.7.2 49.7 1.7.1 8.6 4.4 35.2 8.6 52.2 13.7 56.5 39.7 102.6 81.4 144.5 17.6 17.7 31.4 28.7 51.6 41.2 68.8 42.8 150.2 55.3 229.4 35.2 40.3-10.2 74.4-26.7 109.7-53.1 20.3-15.1 48.5-45 63.2-66.7 33-49 49.7-99.4 51.8-156.7 1.5-41.8-5.1-78.7-21.7-120.6-7.5-18.8-23.2-46.1-38-65.9-19.5-26-48.4-53.2-75.4-70.9-39.9-26.2-81.5-42.5-127.1-49.7-13.8-2.2-15.8-2.3-129-2.6-63.2-.2-115.6-.6-116.4-.8-1.7-.7.3-2.2 13.9-10.7 31.8-19.8 58.3-31.7 95-42.6 21.4-6.4 40.5-10.1 65-12.5 11-1.1 60.7-.5 73 .8m-3.5 99.7c32.8 6.2 57.5 14.5 84.4 28.4 21.4 11.1 39.6 23.8 58.1 40.6 34.2 30.9 59.4 67.5 75.3 109.3 16.2 42.7 19.6 93.5 9.6 143-3.3 16.5-12.9 43.6-21.5 60.6-7.8 15.7-21.6 37.2-32.7 50.8-8.3 10.3-27.3 29.1-37.7 37.5-34.2 27.3-77.2 47.6-118 55.5-19.9 3.9-28.1 4.6-52.5 4.5-19.4-.1-26.7-.5-38-2.2-64.4-10-123.7-43.9-166-95.2-29.2-35.3-49.5-80.3-57.5-127.1-1.2-6.6-2.3-15.6-2.7-19.8l-.6-7.8 18.4-.5c10.1-.3 25.2-.3 33.6 0l15.2.5.6 4.6c3.5 26.4 10.9 50.7 22.1 73 28.6 56.7 84.8 97.1 148.4 106.7 14 2.1 41.1 2 55.5-.1 58.9-8.8 109.3-40.7 142.5-90.3 7.8-11.7 18.9-34.5 22.9-47.1 13.1-41.1 13.3-85.1.5-124.1-7.8-23.6-18.8-43.8-33.8-61.9-34.1-40.9-74.1-64.5-125.9-74.4-11.1-2.1-12.9-2.1-173.1-2.4-89.1-.2-162.6-.7-163.3-1.2-2.7-1.5 18-28.4 38.4-49.9l13.5-14.3 135.2.4 135.1.3z"/>
        </svg>
        <span>The Clam AI</span>
      </a>
      <p class="footer__tagline">{t.footer.tagline}</p>
    </div>

    <nav aria-label={t.footer.nav_label} class="footer__nav">
      <div>
        <p class="footer__h">{t.footer.product}</p>
        <ul class="footer__list">
          <li><a href="#how" class="footer__link">{t.nav.how_it_works}</a></li>
          <li><a href="#verticals" class="footer__link">{t.nav.verticals}</a></li>
          <li><a href="#pricing" class="footer__link">{t.nav.pricing}</a></li>
          <li><a href="#faq" class="footer__link">{t.nav.faq}</a></li>
        </ul>
      </div>
      <div>
        <p class="footer__h">{t.footer.links_legal}</p>
        <ul class="footer__list">
          <li><a href={privacyHref} class="footer__link">{t.footer.links_privacy}</a></li>
          <li><a href={termsHref} class="footer__link">{t.footer.links_terms}</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer__bottom">
    <p class="footer__copy">© {year} The Clam AI. {t.footer.rights}</p>
    <div class="footer__bottom-right">
      <LangToggle />
      <a href="mailto:hello@theclamai.com" class="footer__email">hello@theclamai.com</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: var(--sp-7) var(--sp-5);
    max-width: var(--container);
    margin: 0 auto;
  }
  .footer__inner {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }
  .footer__brand {
    flex: 1;
    min-width: 220px;
  }
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-2);
  }
  .footer__tagline {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    line-height: 1.55;
    max-width: 240px;
    margin: 0;
  }
  .footer__nav {
    display: flex;
    gap: var(--sp-7);
    flex-wrap: wrap;
  }
  .footer__h {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin: 0 0 var(--sp-3);
    font-weight: 600;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .footer__link {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__link:hover {
    color: var(--text);
  }
  .footer__bottom {
    margin-top: var(--sp-6);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
  .footer__copy {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    margin: 0;
  }
  .footer__bottom-right {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }
  .footer__email {
    font-size: var(--fs-xs);
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer__email:hover {
    color: var(--accent);
  }
</style>
