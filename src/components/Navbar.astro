---
import LangToggle from './LangToggle.astro';
import Logo from './Logo.astro';
import { getLocale, dict } from '../i18n';
import { waGenericDemoLink, waLink, VERTICALS } from '../data/demos';

const lang = getLocale(Astro.url);
const t = dict(lang);

const WA_LINK = waGenericDemoLink(lang);
const demoLinks = Object.fromEntries(VERTICALS.map((v) => [v.id, waLink(v.id, lang)]));

const links = [
  { href: "#how", label: t.nav.how_it_works },
  { href: "#verticals", label: t.nav.verticals },
  { href: "#pricing", label: t.nav.pricing },
  { href: "#faq", label: t.nav.faq },
];

const ctaLabel = t.nav.cta;
---

<nav
  x-data="{ open: false }"
  style="position:fixed;top:16px;left:50%;transform:translateX(-50%);z-index:100;width:max-content;max-width:calc(100vw - 32px);"
>
  <!-- Pill container -->
  <div style="display:flex;align-items:center;gap:0;background:rgba(0,0,0,0.85);border:1px solid rgba(255,255,255,0.08);border-radius:9999px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:10px 10px 10px 24px;">

    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:10px;margin-right:36px;text-decoration:none;font-size:15px;">
      <Logo size={24} />
    </a>

    <!-- Desktop links -->
    <div class="nav-links-desktop" style="display:flex;align-items:center;gap:4px;margin-right:20px;">
      {links.map((link) => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </div>

    <!-- Lang toggle (desktop) -->
    <div class="nav-lang-desktop" style="margin-right:12px;">
      <LangToggle />
    </div>

    <!-- CTA (desktop) -->
    <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="nav-cta nav-cta-desktop"
       data-demo-cta
       data-track="cta_click_navbar" data-track-source="desktop">
      {ctaLabel} →
    </a>

    <!-- Mobile hamburger -->
    <button
      x-on:click="open = !open"
      class="nav-hamburger"
      aria-label={t.a11y.menu_toggle}
      style="display:none;background:transparent;border:none;cursor:pointer;padding:8px;margin-left:4px;"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path x-show="!open" d="M2 4.5h14M2 9h14M2 13.5h14" stroke="#ededed" stroke-width="1.5" stroke-linecap="round"/>
        <path x-show="open" d="M4 4l10 10M4 14L14 4" stroke="#ededed" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile dropdown -->
  <div
    x-show="open"
    x-transition:enter="nav-enter"
    x-transition:enter-start="nav-enter-start"
    x-transition:enter-end="nav-enter-end"
    x-transition:leave="nav-leave"
    x-transition:leave-start="nav-leave-start"
    x-transition:leave-end="nav-leave-end"
    class="nav-mobile-menu"
    style="display:none;"
    x-on:click.away="open = false"
  >
    {links.map((link) => (
      <a href={link.href} x-on:click="open = false" class="nav-mobile-link">{link.label}</a>
    ))}
    <div style="margin-top:8px;display:flex;justify-content:center;">
      <LangToggle />
    </div>
    <a href={WA_LINK} target="_blank" rel="noopener noreferrer" class="nav-cta"
       style="display:block;text-align:center;margin-top:8px;"
       data-demo-cta
       data-track="cta_click_navbar" data-track-source="mobile">
      {ctaLabel} →
    </a>
  </div>
</nav>

<script is:inline define:vars={{ demoLinks, WA_LINK }}>
  (() => {
    const storageKey = 'clamai:selected-vertical';
    const updateDemoLinks = (vertical) => {
      const href = demoLinks[vertical] || WA_LINK;
      document.querySelectorAll('[data-demo-cta]').forEach((link) => {
        link.setAttribute('href', href);
      });
    };

    try {
      updateDemoLinks(window.localStorage?.getItem(storageKey));
    } catch (_) {
      updateDemoLinks(null);
    }

    window.addEventListener('clamai:vertical-changed', (event) => {
      updateDemoLinks(event.detail?.vertical);
    });
  })();
</script>

<style>
  /* Desktop link base */
  .nav-link {
    font-size: 13px;
    color: #888;
    padding: 7px 16px;
    border-radius: 9999px;
    transition: color 0.15s, background 0.15s;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-link:hover {
    color: #ededed;
    background: rgba(255,255,255,0.06);
  }

  /* CTA button */
  .nav-cta {
    font-size: 13px;
    font-weight: 600;
    background: #D4AF37;
    color: #000;
    padding: 10px 22px;
    border-radius: 9999px;
    white-space: nowrap;
    transition: background 0.15s;
    text-decoration: none;
  }
  .nav-cta:hover {
    background: #E8C547;
  }

  /* Mobile menu panel */
  .nav-mobile-menu {
    margin-top: 8px;
    background: rgba(0,0,0,0.92);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: 12px;
  }
  .nav-mobile-link {
    display: block;
    font-size: 14px;
    color: #888;
    padding: 12px 16px;
    border-radius: 10px;
    transition: color 0.15s, background 0.15s;
    text-decoration: none;
  }
  .nav-mobile-link:hover {
    color: #ededed;
    background: rgba(255,255,255,0.06);
  }

  /* Transitions */
  .nav-enter { transition: opacity 0.15s, transform 0.15s; }
  .nav-enter-start { opacity: 0; transform: translateY(-4px); }
  .nav-enter-end { opacity: 1; transform: translateY(0); }
  .nav-leave { transition: opacity 0.1s; }
  .nav-leave-start { opacity: 1; }
  .nav-leave-end { opacity: 0; }

  /* Responsive */
  @media (max-width: 640px) {
    .nav-links-desktop { display: none !important; }
    .nav-cta-desktop { display: none !important; }
    .nav-lang-desktop { display: none !important; }
    .nav-hamburger { display: block !important; }
  }
</style>
