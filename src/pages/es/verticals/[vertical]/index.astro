---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import VerticalPage from '../../../../components/VerticalPage.astro';
import {
  PAGE_ENABLED_VERTICALS,
  VERTICAL_SLUGS,
  slugToVerticalId,
} from '../../../../data/demos';
import { dict } from '../../../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return PAGE_ENABLED_VERTICALS.map((id) => ({
    params: { vertical: VERTICAL_SLUGS[id] },
  }));
}

const { vertical: slug } = Astro.params;
const verticalId = slug ? slugToVerticalId(slug) : null;
if (!verticalId) {
  return Astro.redirect('/es/');
}

const lang = 'es';
const t = dict(lang);
const meta = t.verticals_pages[verticalId].meta;
---

<BaseLayout title={meta.title} description={meta.description} lang={lang}>
  <VerticalPage verticalId={verticalId} lang={lang} />
</BaseLayout>
